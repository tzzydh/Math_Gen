<view class="page" wx:if="{{loading}}">
  <view class="card">
    <view class="section-title">正在生成志愿报告...</view>
  </view>
</view>

<view class="page" wx:elif="{{error}}">
  <view class="card">
    <view class="section-title">结果加载失败</view>
    <view class="text-block">{{error}}</view>
  </view>
</view>

<view class="page" wx:elif="{{result}}">
  <view class="hero">
    <view class="hero-title">{{result.province}} · {{result.trackLabel}} · {{result.score}}分</view>
    <view class="hero-subtitle">估算位次 {{result.calculated_rank}} 名 · {{result.subject_combination}}</view>
    <view class="hero-meta">本次共生成 {{result.recommendationCount}} 个推荐方案</view>
  </view>

  <view class="actions-card">
    <button class="download-btn" bindtap="handleDownloadPlanPdf" loading="{{downloading}}" disabled="{{downloading}}">
      下载完整 PDF 报告
    </button>
  </view>

  <view class="card">
    <view class="section-title">顾问引擎</view>
    <view class="stats-row">
      <view class="stat-pill">
        <view class="stat-label">生成方式</view>
        <view class="stat-value compact">{{result.advisorModeLabel}}</view>
      </view>
      <view class="stat-pill">
        <view class="stat-label">供应商 / 模型</view>
        <view class="stat-value compact">{{result.advisorProviderLabel}} / {{result.advisorModelLabel}}</view>
      </view>
    </view>
    <view class="text-block engine-note" wx:if="{{result.advisorEngineNote}}">{{result.advisorEngineNote}}</view>
  </view>

  <view class="card">
    <view class="section-title">顾问结论</view>
    <view class="text-block preserve">{{result.summary}}</view>
  </view>

  <view class="card">
    <view class="section-title">关键定位</view>
    <view class="stats-row">
      <view class="stat-pill">
        <view class="stat-label">高考分数</view>
        <view class="stat-value">{{result.score}}分</view>
      </view>
      <view class="stat-pill">
        <view class="stat-label">估算位次</view>
        <view class="stat-value">{{result.calculated_rank}}名</view>
      </view>
      <view class="stat-pill" wx:for="{{result.controlLines}}" wx:key="line_type">
        <view class="stat-label">{{item.label}}</view>
        <view class="stat-value">{{item.score}}分</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">张雪峰式判断</view>
    <view wx:for="{{result.advisor_takeaways}}" wx:key="index" class="list-item">
      <view class="bullet"></view>
      <view class="list-text">{{item}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{result.deep_analysis.length}}">
    <view class="section-title">深度顾问分析</view>
    <view wx:for="{{result.deep_analysis}}" wx:key="index" class="list-item">
      <view class="bullet"></view>
      <view class="list-text">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">方向判断</view>
    <view wx:for="{{result.direction_cards}}" wx:key="title" class="direction-card">
      <view class="direction-title">{{item.title}}</view>
      <view class="text-block">{{item.content}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">择校逻辑</view>
    <view wx:for="{{result.school_choice_logic}}" wx:key="index" class="list-item">
      <view class="bullet"></view>
      <view class="list-text">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">专业提醒</view>
    <view wx:for="{{result.major_observations}}" wx:key="index" class="list-item">
      <view class="bullet"></view>
      <view class="list-text">{{item}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{result.majorProfile}}">
    <view class="section-title">专业详细解析</view>
    <view class="stats-row">
      <view class="stat-pill">
        <view class="stat-label">目标专业</view>
        <view class="stat-value compact">{{result.majorProfile.major_name}}</view>
      </view>
      <view class="stat-pill" wx:if="{{result.majorProfile.major_category}}">
        <view class="stat-label">专业大类</view>
        <view class="stat-value compact">{{result.majorProfile.major_category}}</view>
      </view>
      <view class="stat-pill" wx:if="{{result.majorProfile.duration}}">
        <view class="stat-label">学制</view>
        <view class="stat-value compact">{{result.majorProfile.duration}}</view>
      </view>
      <view class="stat-pill" wx:if="{{result.majorProfile.degree}}">
        <view class="stat-label">学位</view>
        <view class="stat-value compact">{{result.majorProfile.degree}}</view>
      </view>
    </view>

    <view class="direction-card" wx:if="{{result.majorProfile.overview || result.majorProfile.training_goal}}">
      <view class="direction-title">专业介绍</view>
      <view class="text-block">{{result.majorProfile.overview || result.majorProfile.training_goal}}</view>
    </view>

    <view class="direction-card">
      <view class="direction-title">就业与考研</view>
      <view class="text-block" wx:if="{{result.majorProfile.employment_rate}}">就业率参考：{{result.majorProfile.employment_rate}}</view>
      <view class="text-block" wx:if="{{result.majorProfile.salary_after_5y}}">五年月薪参考：{{result.majorProfile.salary_after_5y}}</view>
      <view class="tag-row" wx:if="{{result.majorProfile.postgraduate_paths.length}}">
        <view class="tag-pill" wx:for="{{result.majorProfile.postgraduate_paths}}" wx:key="index">{{item}}</view>
      </view>
    </view>

    <view class="direction-card" wx:if="{{result.majorProfile.top_jobs.length}}">
      <view class="direction-title">典型岗位</view>
      <view class="tag-row">
        <view class="tag-pill" wx:for="{{result.majorProfile.top_jobs}}" wx:key="index">{{item}}</view>
      </view>
    </view>

    <view class="direction-card" wx:if="{{result.majorProfile.similar_majors.length}}">
      <view class="direction-title">相似专业</view>
      <view class="tag-row">
        <view class="tag-pill" wx:for="{{result.majorProfile.similar_majors}}" wx:key="index">{{item}}</view>
      </view>
    </view>

    <view class="stats-row" wx:if="{{result.majorProfile.strengths.length || result.majorProfile.weaknesses.length}}">
      <view class="analysis-block positive-block" wx:if="{{result.majorProfile.strengths.length}}">
        <view class="analysis-title">优势</view>
        <view wx:for="{{result.majorProfile.strengths}}" wx:key="index" class="mini-list-item">
          <view class="mini-bullet"></view>
          <view class="mini-list-text">{{item}}</view>
        </view>
      </view>
      <view class="analysis-block caution-block" wx:if="{{result.majorProfile.weaknesses.length}}">
        <view class="analysis-title">短板</view>
        <view wx:for="{{result.majorProfile.weaknesses}}" wx:key="index" class="mini-list-item">
          <view class="mini-bullet caution-mini-bullet"></view>
          <view class="mini-list-text">{{item}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{result.majorBreakdown.length}}">
    <view class="section-title">{{result.majorProfile ? '专业深度建议' : '方向深度建议'}}</view>
    <view wx:for="{{result.majorBreakdown}}" wx:key="title" class="direction-card">
      <view class="direction-title">{{item.title}}</view>
      <view class="text-block">{{item.content}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{result.signatureAdvice.length}}">
    <view class="section-title">我们的额外判断</view>
    <view wx:for="{{result.signatureAdvice}}" wx:key="index" class="list-item">
      <view class="bullet"></view>
      <view class="list-text">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">填报策略</view>
    <view wx:for="{{result.strategy}}" wx:key="index" class="list-item">
      <view class="bullet"></view>
      <view class="list-text">{{item}}</view>
    </view>
  </view>

  <view class="card warning-card">
    <view class="section-title">风险提醒</view>
    <view wx:for="{{result.risk_notes}}" wx:key="index" class="list-item">
      <view class="bullet warning-bullet"></view>
      <view class="list-text">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">执行清单</view>
    <view wx:for="{{result.execution_checklist}}" wx:key="index" class="list-item">
      <view class="bullet"></view>
      <view class="list-text">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">吉林数据版推荐</view>
    <view wx:for="{{result.bucketGroups}}" wx:key="key" class="bucket-block">
      <view class="bucket-title">{{item.title}}</view>
      <view wx:for="{{item.items}}" wx:key="index" class="recommendation-card">
        <view class="recommendation-head">
          <view class="recommendation-title">{{item.school}} · {{item.major}}</view>
          <view class="score-pill">{{item.bucketLabel}}</view>
        </view>
        <view class="recommendation-meta">
          {{item.city}}
          <text wx:if="{{item.school_level}}"> · {{item.school_level}}</text>
        </view>
        <view class="recommendation-meta">
          排序分 {{item.ranking_score || item.fit_score}}
          <text> · </text>
          2025最低分 {{item.min_score}}分
          <text wx:if="{{item.min_rank}}"> · 最低位次 {{item.min_rank}}</text>
          <text wx:if="{{item.plan_count}}"> · 计划 {{item.plan_count}}人</text>
        </view>
        <view class="recommendation-meta" wx:if="{{item.year_span}}">覆盖年份：{{item.year_span}}</view>
        <view class="tag-row" wx:if="{{item.decision_tags.length}}">
          <view class="tag-pill" wx:for="{{item.decision_tags}}" wx:key="index">{{item}}</view>
        </view>
        <view class="recommendation-meta" wx:if="{{item.rankingReasonText}}">
          排序依据：{{item.rankingReasonText}}
        </view>
        <view class="text-block">{{item.reason}}</view>
        <view class="major-comment" wx:if="{{item.major_comment}}">{{item.major_comment}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{result.extendedPoolGroups.length}}">
    <view class="section-title">方向扩展学校池</view>
    <view class="text-block" wx:if="{{result.schoolPoolNote}}">{{result.schoolPoolNote}}</view>
    <view wx:for="{{result.extendedPoolGroups}}" wx:key="key" class="bucket-block">
      <view class="bucket-title">{{item.title}}</view>
      <view wx:for="{{item.items}}" wx:key="index" class="recommendation-card">
        <view class="recommendation-head">
          <view class="recommendation-title">{{item.school}} · {{item.major}}</view>
          <view class="score-pill neutral-pill">{{item.fit_label}}</view>
        </view>
        <view class="recommendation-meta">
          {{item.city}}
          <text wx:if="{{item.school_level}}"> · {{item.school_level}}</text>
        </view>
        <view class="recommendation-meta">
          {{item.evidence_label || '公开信息'}}
          <text wx:if="{{item.reference_score !== null && item.reference_score !== undefined}}"> · 参考分数 {{item.reference_score}}分</text>
        </view>
        <view class="tag-row" wx:if="{{item.decision_tags.length}}">
          <view class="tag-pill" wx:for="{{item.decision_tags}}" wx:key="index">{{item}}</view>
        </view>
        <view class="text-block">{{item.reason}}</view>
      </view>
    </view>
  </view>
</view>

<view class="page empty-page" wx:else>
  <view class="card">
    <view class="section-title">暂无规划结果</view>
    <view class="text-block">请先返回上一页生成吉林志愿方案。</view>
  </view>
</view>
