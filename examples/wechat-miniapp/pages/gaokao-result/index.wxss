.page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at top left, rgba(34, 197, 94, 0.12), transparent 34%),
    linear-gradient(180deg, #f3fff5 0%, #fbfffd 100%);
}

.hero,
.card,
.actions-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(15, 23, 42, 0.08);
}

.hero {
  background: linear-gradient(135deg, #14532d 0%, #16a34a 100%);
}

.hero-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.45;
}

.hero-subtitle,
.hero-meta {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.7;
}

.actions-card,
.card {
  margin-top: 24rpx;
}

.download-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.warning-card {
  background: linear-gradient(180deg, #fffdf3 0%, #ffffff 100%);
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-pill {
  min-width: 180rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #f0fdf4;
  border: 1rpx solid #dcfce7;
}

.stat-label {
  color: #15803d;
  font-size: 22rpx;
}

.stat-value {
  margin-top: 8rpx;
  color: #14532d;
  font-size: 30rpx;
  font-weight: 700;
}

.stat-value.compact {
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #14532d;
}

.text-block {
  color: #334155;
  line-height: 1.8;
}

.engine-note {
  margin-top: 16rpx;
}

.preserve {
  white-space: pre-wrap;
}

.list-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 14rpx;
}

.bullet {
  width: 14rpx;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #16a34a;
  flex-shrink: 0;
}

.warning-bullet {
  background: #d97706;
}

.list-text {
  flex: 1;
  color: #475569;
  line-height: 1.8;
}

.direction-card {
  margin-top: 14rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f7fff8;
  border: 1rpx solid #dcfce7;
}

.direction-title {
  margin-bottom: 10rpx;
  color: #166534;
  font-size: 28rpx;
  font-weight: 700;
}

.bucket-block + .bucket-block {
  margin-top: 28rpx;
}

.bucket-title {
  margin-bottom: 12rpx;
  color: #166534;
  font-size: 28rpx;
  font-weight: 700;
}

.recommendation-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f7fff8 0%, #ffffff 100%);
  border: 1rpx solid #dcfce7;
}

.recommendation-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.recommendation-title {
  flex: 1;
  color: #14532d;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.score-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 22rpx;
  font-weight: 700;
}

.recommendation-meta {
  margin-top: 10rpx;
  color: #15803d;
  font-size: 24rpx;
  line-height: 1.7;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #166534;
  font-size: 22rpx;
}

.major-comment {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.8;
}

.empty-page {
  display: flex;
  align-items: center;
}
