.page {
  min-height: 100vh;
  padding: 24rpx;
  background:
    radial-gradient(circle at top left, rgba(34, 197, 94, 0.12), transparent 28%),
    linear-gradient(180deg, #f3fff6 0%, #fbfefc 100%);
}

.header-card,
.card {
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.08);
}

.header-card {
  background: linear-gradient(135deg, #166534 0%, #16a34a 100%);
}

.header-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.header-subtitle,
.header-meta {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.75;
}

.card {
  margin-top: 24rpx;
}

.consult-card {
  background: linear-gradient(180deg, #f7fff8 0%, #ffffff 100%);
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #14532d;
}

.two-col {
  display: flex;
  gap: 18rpx;
}

.two-col .field-group {
  flex: 1;
}

.field-group {
  margin-top: 18rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #166534;
  font-size: 26rpx;
  font-weight: 700;
}

.field-input {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  border: 2rpx solid #bbf7d0;
  background: #f7fff8;
  color: #14532d;
  font-size: 28rpx;
}

.static-field {
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #ecfdf3;
  border: 2rpx solid #bbf7d0;
  color: #166534;
  font-size: 28rpx;
  font-weight: 700;
}

.notes-input {
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 2rpx solid #bbf7d0;
  background: #f7fff8;
  color: #14532d;
  font-size: 28rpx;
  line-height: 1.7;
}

.field-placeholder {
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 1.6;
}

.primary-btn,
.secondary-btn {
  margin-top: 28rpx;
  border-radius: 20rpx;
  font-weight: 700;
  font-size: 30rpx;
}

.primary-btn {
  background: #16a34a;
  color: #ffffff;
}

.secondary-btn {
  background: #14532d;
  color: #ffffff;
}

.meta-line {
  margin-top: 18rpx;
  color: #166534;
  font-size: 26rpx;
}

.result-block {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f0fdf4;
}

.error-block {
  background: #fef2f2;
}

.result-label {
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #14532d;
}

.result-text {
  color: #166534;
  line-height: 1.75;
}

.consult-opening {
  color: #334155;
  line-height: 1.8;
  font-size: 28rpx;
}

.next-step {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ecfdf3;
  color: #166534;
  font-size: 26rpx;
  line-height: 1.7;
}

.list-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 14rpx;
}

.bullet {
  width: 14rpx;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #16a34a;
  flex-shrink: 0;
}

.list-text {
  flex: 1;
  color: #475569;
  line-height: 1.8;
}

.question-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #dcfce7;
  background: #ffffff;
}

.question-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.question-title {
  flex: 1;
  color: #14532d;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.question-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 22rpx;
  font-weight: 700;
}

.question-text {
  margin-top: 14rpx;
  color: #334155;
  font-size: 27rpx;
  line-height: 1.8;
}

.question-why {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  color: #166534;
  font-size: 24rpx;
}
