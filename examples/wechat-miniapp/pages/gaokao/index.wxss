.page {
  min-height: 100vh;
  padding: 24rpx;
  background:
    radial-gradient(circle at top left, rgba(34, 197, 94, 0.12), transparent 28%),
    linear-gradient(180deg, #f3fff6 0%, #fbfefc 100%);
}

.header-card,
.card {
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.08);
}

.header-card {
  background: linear-gradient(135deg, #166534 0%, #16a34a 100%);
}

.header-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.header-subtitle,
.header-meta {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.75;
}

.card {
  margin-top: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #14532d;
}

.section-gap {
  margin-top: 24rpx;
}

.two-col {
  display: flex;
  gap: 18rpx;
}

.two-col .field-group {
  flex: 1;
}

.field-group {
  margin-top: 18rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #166534;
  font-size: 26rpx;
  font-weight: 700;
}

.field-input {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  border: 2rpx solid #bbf7d0;
  background: #f7fff8;
  color: #14532d;
  font-size: 28rpx;
}

.static-field {
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #ecfdf3;
  border: 2rpx solid #bbf7d0;
  color: #166534;
  font-size: 28rpx;
  font-weight: 700;
}

.notes-input {
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 2rpx solid #bbf7d0;
  background: #f7fff8;
  color: #14532d;
  font-size: 28rpx;
  line-height: 1.7;
}

.field-placeholder {
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 1.6;
}

.primary-btn {
  margin-top: 28rpx;
  background: #16a34a;
  color: #ffffff;
  border-radius: 20rpx;
  font-weight: 700;
  font-size: 30rpx;
}

.meta-line {
  margin-top: 18rpx;
  color: #166534;
  font-size: 26rpx;
}

.result-block {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f0fdf4;
}

.error-block {
  background: #fef2f2;
}

.result-label {
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #14532d;
}

.result-text {
  color: #166534;
  line-height: 1.75;
}

.history-item {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7fff8;
  border: 1rpx solid #dcfce7;
}

.history-title {
  color: #14532d;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.history-summary {
  margin-top: 12rpx;
  color: #166534;
  line-height: 1.75;
}
