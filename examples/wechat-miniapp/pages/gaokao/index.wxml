<view class="page">
  <view class="hero-card">
    <view class="hero-eyebrow">吉林高考志愿系统</view>
    <view class="hero-title">先问清条件，再生成最终方案</view>
    <view class="hero-subtitle">
      问诊拆成 3 个模块：基础建档、顾问追问、最终方案。每一步都能直接点进去，不需要长距离来回滚动。
    </view>
    <view class="hero-meta">
      <view class="hero-pill">当前省份：{{province}}</view>
      <view class="hero-pill">登录状态：{{token ? '已登录' : '未登录'}}</view>
    </view>
  </view>

  <view class="step-rail">
    <view
      wx:for="{{stepOptions}}"
      wx:key="key"
      class="step-card {{activeModule === item.key ? 'step-card-active' : ''}}"
      data-module="{{item.key}}"
      bindtap="handleModuleTap"
    >
      <view class="step-label">{{item.label}}</view>
      <view class="step-caption">{{item.caption}}</view>
    </view>
  </view>

  <view class="summary-card">
    <view class="summary-title">当前建档摘要</view>
    <view class="summary-grid">
      <view class="summary-cell">
        <view class="summary-k">分数</view>
        <view class="summary-v">{{score || '未填写'}}</view>
      </view>
      <view class="summary-cell">
        <view class="summary-k">位次</view>
        <view class="summary-v">{{rank || '自动换算'}}</view>
      </view>
      <view class="summary-cell">
        <view class="summary-k">选科</view>
        <view class="summary-v">{{subjectCombination || '未填写'}}</view>
      </view>
      <view class="summary-cell">
        <view class="summary-k">状态</view>
        <view class="summary-v">{{consultStatus || planningStatus || '待开始'}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeModule === 'basic'}}" class="panel-card">
    <view class="panel-title">模块一：基础建档</view>
    <view class="panel-desc">先锁定最重要的 3 个硬条件：分数、位次、选科。位次可以不填，系统会自动换算。</view>

    <view class="two-col">
      <view class="field-group">
        <view class="field-label">高考分数</view>
        <input
          class="field-input"
          placeholder="例如：567"
          placeholder-class="field-placeholder"
          data-field="score"
          value="{{score}}"
          bindinput="handleFieldInput"
        />
      </view>

      <view class="field-group">
        <view class="field-label">位次</view>
        <input
          class="field-input"
          placeholder="可选，不填则自动换算"
          placeholder-class="field-placeholder"
          data-field="rank"
          value="{{rank}}"
          bindinput="handleFieldInput"
        />
      </view>
    </view>

    <view class="field-group">
      <view class="field-label">选科组合</view>
      <input
        class="field-input"
        placeholder="例如：物化生 / 史政地"
        placeholder-class="field-placeholder"
        data-field="subjectCombination"
        value="{{subjectCombination}}"
        bindinput="handleFieldInput"
      />
    </view>

    <button class="primary-btn" bindtap="handleStartConsultation" disabled="{{!token}}" loading="{{consulting}}">
      开始顾问问诊
    </button>
    <view class="meta-line">问诊状态：{{consultStatus || '-'}}</view>

    <view wx:if="{{consultError}}" class="result-block error-block">
      <view class="result-label">问诊错误</view>
      <view class="result-text">{{consultError}}</view>
    </view>
  </view>

  <view wx:if="{{activeModule === 'consult'}}" class="panel-card consult-card">
    <view class="panel-title">模块二：顾问追问</view>
    <view class="panel-desc">每个问题点一个最贴近的答案就行。选中后会立即生效，确认无误再进入最终方案。</view>

    <view wx:if="{{!consultation}}" class="empty-card">
      <view class="empty-title">还没有生成追问</view>
      <view class="empty-text">先在“基础建档”里填写分数和选科，再点击“开始顾问问诊”。</view>
    </view>

    <view wx:if="{{consultation}}">
      <view class="consult-opening">{{consultation.opening}}</view>
      <view class="consult-progress">{{consultation.completionText}}</view>

      <view wx:for="{{consultation.quick_judgment}}" wx:key="index" wx:for-item="judgment" class="list-item">
        <view class="bullet"></view>
        <view class="list-text">{{judgment}}</view>
      </view>

      <view class="next-step">{{consultation.next_step}}</view>

      <view wx:for="{{consultation.questions}}" wx:key="id" wx:for-item="question" class="question-card">
        <view class="question-top">
          <view class="question-title">{{index + 1}}. {{question.title}}</view>
          <view class="question-badge" wx:if="{{question.required}}">必答</view>
        </view>
        <view class="question-text">{{question.question}}</view>
        <view class="question-why">{{question.why}}</view>
        <view class="chip-row" wx:if="{{question.suggested_options.length}}">
          <view
            wx:for="{{question.suggested_options}}"
            wx:key="index"
            wx:for-item="option"
            class="chip {{question.currentValue === option ? 'chip-active' : ''}}"
            data-field="{{question.field}}"
            data-value="{{option}}"
            bindtap="handleQuestionOptionTap"
          >
            {{option}}
          </view>
        </view>
        <view class="selected-hint" wx:if="{{question.currentValue}}">
          当前已选：{{question.currentValue}}
        </view>
      </view>

      <button class="primary-btn consult-confirm-btn" bindtap="handleConfirmConsultation">
        确认已选完，进入最终方案
      </button>
    </view>
  </view>

  <view wx:if="{{activeModule === 'final'}}" class="panel-card">
    <view class="panel-title">模块三：最终方案</view>
    <view class="panel-desc">这里只放真正影响结果的偏好项。前面追问里选过的内容，已经自动带到这里了。</view>

    <view class="field-group">
      <view class="field-label">顾问模式</view>
      <view class="chip-row">
        <view
          wx:for="{{advisorModeOptions}}"
          wx:key="value"
          class="chip {{advisorMode === item.value ? 'chip-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleAdvisorModeTap"
        >
          {{item.label}}
        </view>
      </view>
      <view class="question-why">混合增强：规则引擎先给硬结论，再由大模型做顾问级润色与深度分析。</view>
    </view>

    <view class="field-group">
      <view class="field-label">模型供应商</view>
      <view class="chip-row">
        <view
          wx:for="{{advisorProviderOptions}}"
          wx:key="value"
          class="chip {{advisorProvider === item.value ? 'chip-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleAdvisorProviderTap"
        >
          {{item.label}}
        </view>
      </view>
      <view class="question-why">GLM 走智谱兼容接口；OpenAI 走独立的 OpenAI 接口与密钥。</view>
    </view>

    <view class="field-group">
      <view class="field-label">顾问模型</view>
      <view class="chip-row">
        <view
          wx:for="{{advisorModelOptions}}"
          wx:key="value"
          class="chip {{advisorModel === item.value ? 'chip-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleAdvisorModelTap"
        >
          {{item.label}}
        </view>
      </view>
      <input
        class="field-input"
        placeholder="可选：自定义模型名，留空则用系统默认"
        placeholder-class="field-placeholder"
        data-field="advisorModel"
        value="{{advisorModel}}"
        bindinput="handleFieldInput"
      />
    </view>

    <view class="field-group">
      <view class="field-label">意向专业</view>
      <input
        class="field-input"
        placeholder="例如：电子信息、计算机、临床医学、法学"
        placeholder-class="field-placeholder"
        data-field="preferredMajors"
        value="{{preferredMajors}}"
        bindinput="handleFieldInput"
      />
    </view>

    <view class="field-group">
      <view class="field-label">意向城市</view>
      <input
        class="field-input"
        placeholder="例如：长春、沈阳、天津、杭州"
        placeholder-class="field-placeholder"
        data-field="preferredCities"
        value="{{preferredCities}}"
        bindinput="handleFieldInput"
      />
    </view>

    <view class="field-group">
      <view class="field-label">职业倾向</view>
      <input
        class="field-input"
        placeholder="例如：工程技术 / 稳定编制 / 高薪就业 / 读研优先"
        placeholder-class="field-placeholder"
        data-field="careerPreferences"
        value="{{careerPreferences}}"
        bindinput="handleFieldInput"
      />
    </view>

    <view class="field-group">
      <view class="field-label">家庭预算</view>
      <input
        class="field-input"
        placeholder="例如：优先公办 / 预算一般 / 学费不是主要问题"
        placeholder-class="field-placeholder"
        data-field="familyBudget"
        value="{{familyBudget}}"
        bindinput="handleFieldInput"
      />
    </view>

    <view class="field-group">
      <view class="field-label">补充说明</view>
      <textarea
        class="notes-input"
        placeholder="例如：接受调剂、后期考研、优先双一流、不能接受外省"
        placeholder-class="field-placeholder"
        data-field="notes"
        value="{{notes}}"
        bindinput="handleFieldInput"
      />
    </view>

    <button class="primary-btn" bindtap="handleCreatePlan" disabled="{{!token}}" loading="{{creatingPlan}}">
      生成最终志愿方案
    </button>
    <view class="meta-line">规划状态：{{planningStatus || '-'}}</view>

    <view wx:if="{{planningError}}" class="result-block error-block">
      <view class="result-label">规划错误</view>
      <view class="result-text">{{planningError}}</view>
    </view>
  </view>
</view>
