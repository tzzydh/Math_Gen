.page {
  min-height: 100vh;
  padding: 26rpx;
  background:
    radial-gradient(circle at top right, rgba(59, 130, 246, 0.18), transparent 26%),
    radial-gradient(circle at left center, rgba(245, 158, 11, 0.12), transparent 24%),
    linear-gradient(180deg, #edf6ff 0%, #f8fbff 38%, #fffaf2 100%);
}

.hero,
.overview-card,
.module-card {
  border-radius: 32rpx;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.08);
}

.hero {
  padding: 36rpx 30rpx;
  background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 56%, #38bdf8 100%);
}

.hero-eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-subtitle {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  line-height: 1.78;
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.hero-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 22rpx;
}

.login-btn {
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #1d4ed8;
  font-weight: 700;
}

.overview-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
}

.overview-title {
  color: #102a43;
  font-size: 34rpx;
  font-weight: 700;
}

.overview-subtitle {
  margin-top: 10rpx;
  color: #52606d;
  font-size: 25rpx;
  line-height: 1.72;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.module-card {
  padding: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  min-height: 360rpx;
  box-sizing: border-box;
}

.module-math {
  background: linear-gradient(180deg, #ffffff 0%, #f3f8ff 100%);
}

.module-chinese {
  background: linear-gradient(180deg, #fffdf9 0%, #fff3e8 100%);
}

.module-english {
  background: linear-gradient(180deg, #fffdfd 0%, #fdf2f8 100%);
}

.module-gaokao {
  background: linear-gradient(180deg, #f7fff9 0%, #eefbf2 100%);
}

.module-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.module-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.12);
  color: #102a43;
  font-size: 22rpx;
  font-weight: 700;
}

.module-kicker {
  color: #64748b;
  font-size: 22rpx;
}

.module-title {
  margin-top: 18rpx;
  color: #102a43;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.module-desc {
  margin-top: 12rpx;
  color: #52606d;
  font-size: 25rpx;
  line-height: 1.74;
}

.module-btn {
  margin-top: 22rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-weight: 700;
  font-size: 26rpx;
}

.math-btn {
  background: #2563eb;
}

.chinese-btn {
  background: #d9480f;
}

.english-btn {
  background: #db2777;
}

.gaokao-btn {
  background: #15803d;
}
