APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+psycopg://aimath:change_me@localhost:5432/aimath
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change_me
JWT_EXP_MINUTES=1440

WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

OSS_PROVIDER=aliyun
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your_bucket
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_PUBLIC_BASE_URL=https://static.yourdomain.com

OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
GAOKAO_LLM_TIMEOUT_SECONDS=25
GAOKAO_ENABLE_LLM=true
GAOKAO_DEFAULT_PROVIDER=gemini
GAOKAO_DEFAULT_MODEL=
GAOKAO_GLM_API_KEY=
GAOKAO_GLM_BASE_URL=
GAOKAO_GLM_DEFAULT_MODEL=GLM-4.5V
GAOKAO_OPENAI_API_KEY=
GAOKAO_OPENAI_BASE_URL=https://api.openai.com/v1
GAOKAO_OPENAI_DEFAULT_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-flash
GAOKAO_GEMINI_API_KEY=
GAOKAO_GEMINI_DEFAULT_MODEL=gemini-2.5-flash

